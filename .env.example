# Copy to `.env` and fill in (never commit `.env` — it is git-ignored).
# The API loads this file on startup; plain environment variables take precedence.
#
# Narratives come from a LOCAL model via Ollama: case evidence never leaves
# this machine, which is the requirement for MFS data that cannot cross
# borders. Setup once: `ollama pull qwen2.5:3b`, then leave `ollama serve`
# running. Daemon down = deterministic offline templates (demo still works).

# Where the local Ollama daemon listens (LAN host allowed, never a cloud URL).
OLLAMA_HOST=http://localhost:11434
# Small instruction model with usable Bangla (3b class runs on CPU).
OLLAMA_MODEL=qwen2.5:3b
# Max tokens per narrative (the template needs ~150; the daemon is CPU-slow,
# so headroom beyond this only adds seconds). Case review uses it; /score
# always serves the instant template.
OLLAMA_NUM_PREDICT=320

# Shared secret for POST /score + POST /decision (analyst console sends it as
# X-API-Key). Leave empty for open judging demos; set it anywhere exposed.
VIGIL_API_KEY=
# The analyst decision audit log lives in Postgres — this is how the API finds it.
# Local: run a throwaway (`docker run -d -e POSTGRES_PASSWORD=vigil -e
# POSTGRES_USER=vigil -e POSTGRES_DB=vigil -p 5432:5432 postgres:16-alpine`)
# and use the URL below. Hosted: link the Render PostgreSQL and Render injects
# the real URL by the same name. Never put a real password in this file.
DATABASE_URL=postgresql://vigil:vigil@localhost:5432/vigil

# Ops tuning (defaults apply when unset).
VIGIL_ALERTS_LIMIT=200
VIGIL_ALERT_WINDOW=2000
VIGIL_RATE_LIMIT_PER_MIN=120
# SQLite file for users, cases and decisions (git-ignored).
VIGIL_DB_PATH=vigil.db
# Demo accounts admin/admin123 + analyst/analyst123 are seeded into an empty
# DB on startup. Set to 0 in production and create real accounts instead.
VIGIL_SEED_DEMO=1
# Session lifetime for login tokens, in days.
VIGIL_TOKEN_DAYS=30
# Honor X-Forwarded-For for rate buckets (needed behind proxies; only the
# bucket key is affected if spoofed). Set to 0 to use the socket IP only.
VIGIL_TRUST_PROXY=1
# JSON log lines instead of human-readable (log aggregators).
VIGIL_LOG_JSON=0
# LLM provider timeout, seconds (live narratives add provider latency to /score).
VIGIL_LLM_TIMEOUT=15

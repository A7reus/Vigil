# Copy to `.env` and fill in (never commit `.env` — it is git-ignored).
# The API loads this file on startup; plain environment variables take precedence.
# Get a free key: https://console.groq.com/keys

# Live investigator narratives. Unset/empty = deterministic offline templates.
LLM_API_KEY=YOUR_GROQ_KEY_HERE
# Any OpenAI-compatible endpoint + model (default Groq gpt-oss-20b if unset).
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b

# Ops tuning (defaults apply when unset).
VIGIL_ALERTS_LIMIT=200
VIGIL_RATE_LIMIT_PER_MIN=120
